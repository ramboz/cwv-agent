node_modules/
.DS_Store
*.log
results/
screenshots/
.env
.agents/.cache/
# Experiment output (orchestrate session state, debug runs, pulled customer
# source). Bulky and may embed a customer git repo with secrets — never commit.
progress/
# Transient / harness-managed — never commit linked git worktrees or local logs.
.claude/settings.local.json
.claude/*.local.json
.claude/logs/
.claude/worktrees/
.claude/skill-usage.jsonl
.codex/skill-usage.jsonl

# >>> jig secret-ignore >>>
# jig secret-prevention floor (ADR-0013) — git-ignore common secret
# files so they can't be staged by accident. Edit above/below the
# markers; this block is regenerated by jig and re-runs are idempotent.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
*.pem
*.key
secrets/
credentials/
# <<< jig secret-ignore <<<
