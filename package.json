{
  "name": "cwv-agent",
  "version": "3.0.0",
  "description": "CWV performance-fixing toolkit for agentic CLIs",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "puppeteer": "^22.15.0",
    "web-vitals": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@stylistic/eslint-plugin": "^2.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  },
  "scripts": {
    "postinstall": "node .agents/scripts/postinstall-web-vitals.js",
    "artifacts": "node .agents/scripts/local-artifacts.js",
    "doctor": "node .agents/scripts/doctor.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "measure": "node .agents/scripts/launcher.js",
    "playbooks:check": "node .agents/scripts/playbook-sync.js --check",
    "playbooks:sync": "node .agents/scripts/playbook-sync.js",
    "preflight": "node .agents/scripts/preflight.js",
    "setup": "node .agents/scripts/setup.js",
    "test": "node --test .agents/scripts/test/*.test.js .agents/scripts/analyzers/test/*.test.js .agents/scripts/patches/test/*.test.js"
  }
}
